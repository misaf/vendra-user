{
    "name": "misaf/vendra-user",
    "description": "Comprehensive user management module with profiles, authentication, media handling and multi-tenant support",
    "keywords": [
        "laravel",
        "filamentphp",
        "user"
    ],
    "homepage": "https://github.com/misaf/vendra-user",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.3",
        "laravel/pennant": "^1.24",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/laravel-email-validation": "^1.0",
        "misaf/vendra-multimedia": "self.version",
        "misaf/vendra-permission": "self.version",
        "misaf/vendra-support": "self.version",
        "spatie/laravel-package-tools": "^1.93.1",
        "staudenmeir/belongs-to-through": "^2.18"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.12",
        "laravel/pint": "^1.29.3",
        "misaf/vendra-testing": "self.version",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-profanity": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4.3"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraUser\\": "src/",
            "Misaf\\VendraUser\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraUser\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraUser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraUser\\Providers\\UserServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest --parallel",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "suggest": {
        "misaf/vendra-tagger": "Install this in the host application to assign typed tags to users."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-user/issues",
        "source": "https://github.com/misaf/vendra-user"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
